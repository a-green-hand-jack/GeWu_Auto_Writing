{
  "name": "gewu-paperwriter",
  "version": "1.0.0",
  "description": "Source-bound academic writing: turn a code/Solution repository into a complete, honest manuscript, with LKM literature retrieval, per-journal templates, and mechanical pre-delivery checks.",
  "keywords": [
    "pi-package",
    "academic-writing",
    "latex",
    "research",
    "paper"
  ],
  "pi": {
    "skills": [
      "./.agents/skills/paperwriter-pi"
    ]
  },
  "files": [
    ".agents/skills/paperwriter-pi",
    "tools",
    "install.sh",
    "INSTALL.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "gewu-run": ".agents/skills/paperwriter-pi/tools/gewu-run",
    "gewu-batch": ".agents/skills/paperwriter-pi/tools/gewu-batch",
    "gewu-revive": ".agents/skills/paperwriter-pi/tools/gewu-revive",
    "gewu-verify": ".agents/skills/paperwriter-pi/tools/gewu-verify",
    "gewu-lit": ".agents/skills/paperwriter-pi/tools/gewu-lit",
    "gewu-doctor": ".agents/skills/paperwriter-pi/tools/gewu-doctor",
    "pdf-pages": ".agents/skills/paperwriter-pi/tools/pdf-pages"
  },
  "scripts": {
    "doctor": ".agents/skills/paperwriter-pi/tools/gewu-doctor",
    "install-skill": "./install.sh"
  },
  "private": true,
  "_note": "Skills and CLI for source-bound academic writing. The vendored journal templates carry their own terms; see INSTALL.md.",
  "license": "MIT"
}
