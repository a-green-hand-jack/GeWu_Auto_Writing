#!/usr/bin/env bash
# gewu-batch — inspect the GeWu paper-writing batch runs.
#
# Operates on $HOME/GeWu_Auto_Writing/paperwriter-pi-runs/<run>/<solution>/{task.md,run.log,
# exit-code,started-at,finished-at,workspace/}. Inspection never modifies a run;
# explicit handover writes the requested output bundle.
#
# Usage:
#   gewu-batch list                      list run directories, newest first
#   gewu-batch watches [RUN]             one line per run: finished/running/total
#   gewu-batch status [RUN]              per-task table: state, files, tex, bib, pdf, elapsed
#   gewu-batch gates [RUN]               per-paper gate metrics (template, refs, bibliography, theorem envs)
#   gewu-batch report [RUN]              aggregate summary over the tasks in RUN
#   gewu-batch tail RUN TASK [N]         tail a task's run.log (default 40 lines)
#   gewu-batch show RUN TASK FILE        print a file from a task workspace (relative path)
#   gewu-batch handover --out DIR [RUN...]   collect final PDFs + INDEX.md for review
#
# RUN may be a full path, a glob fragment (e.g. 'math5'), or empty for the newest run.
set -uo pipefail

BASE="${GEWU_BATCH_BASE:-$HOME/GeWu_Auto_Writing/paperwriter-pi-runs}"
# Install gewu_tex_metrics.py beside the real gewu-batch script.  The deployed
# ~/.local/bin/gewu-batch is a symlink, so locate its target before finding it.
SCRIPT_PATH="$0"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || printf '%s' "$SCRIPT_PATH")"
fi
METRICS="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/gewu_tex_metrics.py"

die() { echo "gewu-batch: $*" >&2; exit 1; }

# A run directory must contain at least one task directory with a workspace/.
# Without this guard a fragment like "round2" also matches a handover OUTPUT
# directory whose name contains the fragment, which silently yielded a one-row
# bundle instead of the run's 30 manuscripts.
is_run_dir() {
  local d="${1%/}"
  [ -d "$d" ] || return 1
  for t in "$d"/*/; do [ -d "$t/workspace" ] && return 0; done
  return 1
}

resolve_run() {
  local q="${1:-}" cand
  if [ -z "$q" ]; then
    for cand in $(ls -td "$BASE"/*/ 2>/dev/null); do is_run_dir "$cand" && { printf '%s\n' "$cand"; return; }; done
  elif [ -d "$q" ]; then
    printf '%s/\n' "${q%/}"
  else
    for cand in $(ls -td "$BASE"/*"$q"*/ 2>/dev/null); do is_run_dir "$cand" && { printf '%s\n' "$cand"; return; }; done
  fi
}

run_name() { basename "${1%/}"; }

tasks_of() { for d in "$1"/*/; do [ -d "$d/workspace" ] && basename "$d"; done; }

# Metrics must be scoped to the manuscript sources. research/ can hold downloaded
# literature full texts (research/lit/ext/**) whose .tex files carry their own
# documentclass and theorem environments and would otherwise corrupt every count.
paper_scope() {
  local ws="$1/workspace"
  if [ -d "$ws/paper" ]; then printf '%s\n' "$ws/paper"; else printf '%s\n' "$ws"; fi
}

# Emit the source metrics needed by this shell UI in one tab-separated row.
# The helper deliberately reads only main.tex and recursively included in-root
# sources, so downloaded material and stale scratch .tex files do not count.
source_fields() {
  python3 "$METRICS" --root "$1" --main main.tex | python3 -c '
import json, sys
m = json.load(sys.stdin)
values = [
    m.get("document_class") or "-", int(bool(m.get("prx"))),
    "yes" if m.get("floatbarrier") else "NO", m.get("refslabel", "MISSING"),
    m.get("bibitems", 0), m.get("bib_entries", 0), m.get("uncited", "-"), m.get("narration", 0), m.get("theorems", 0), len(m.get("issues", [])),
]
print("\t".join(map(str, values)))
'
}

valid_pdf_of() {
  local pdf="$1"
  [ -n "$pdf" ] || { printf 'no\n'; return; }
  python3 "$METRICS" --valid-pdf "$pdf" | python3 -c 'import json, sys; print(json.load(sys.stdin)["valid_pdf"])'
}

candidate_pdf_of() {
  local ws="$1" pdf=""
  for pdf in "$ws/paper/main.pdf" "$ws/paper/paper.pdf" "$ws/main.pdf" "$ws/paper.pdf"; do
    [ -f "$pdf" ] && { printf '%s\n' "$pdf"; return; }
  done
  printf '\n'
}

# number of tasks of a run currently held by a live pi process
live_of() {
  local name; name="$(run_name "$1")"
  pgrep -af 'task\.md' 2>/dev/null | grep -Fc "/$name/" || true
}

state_of() {
  local d="$1"
  if [ -f "$d/exit-code" ]; then
    local c; c="$(cat "$d/exit-code")"
    [ "$c" = "0" ] && echo "done" || echo "exit:$c"
  else
    echo "running"
  fi
}

elapsed_of() {
  local d="$1" s f
  s="$(cat "$d/started-at" 2>/dev/null)"; [ -z "$s" ] && { echo "-"; return; }
  f="$(cat "$d/finished-at" 2>/dev/null)"
  local end; end="${f:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  local ss es; ss=$(date -u -d "$s" +%s 2>/dev/null) || { echo "-"; return; }
  es=$(date -u -d "$end" +%s 2>/dev/null) || { echo "-"; return; }
  local m=$(( (es - ss) / 60 ))
  printf '%dm' "$m"
}

cmd_list() {
  local d
  for d in $(ls -td "$BASE"/*/ 2>/dev/null); do
    local total done_
    total=$(tasks_of "$d" | wc -l)
    done_=$(for t in $(tasks_of "$d"); do [ -f "$d$t/exit-code" ] && echo x; done | wc -l)
    running="$(live_of "$d")"
    printf '%s  tasks=%-3s finished=%-3s running=%-3s\n' "$(run_name "$d")" "$total" "$done_" "$running"
  done
}

cmd_watches() {
  local run; run="$(resolve_run "${1:-}")"; [ -z "$run" ] && die "no run found"
  local total done_ running
  total=$(tasks_of "$run" | wc -l)
  done_=$(for t in $(tasks_of "$run"); do [ -f "$run$t/exit-code" ] && echo x; done | wc -l)
  running="$(live_of "$run")"
  printf '%s  finished=%s running=%s total=%s\n' "$(run_name "$run")" "$done_" "$running" "$total"
}

cmd_status() {
  local run; run="$(resolve_run "${1:-}")"; [ -z "$run" ] && die "no run found"
  echo "RUN=$(run_name "$run")   now=$(date -u +%H:%M:%SZ)"
  printf '%-46s %-8s %-6s %-5s %-5s %-5s %-6s\n' TASK STATE FILES TEX BIB PDF ELAPSED
  local t state files tex bib pdf el
  for t in $(tasks_of "$run"); do
    local d="$run$t"
    state="$(state_of "$d")"
    files=$(find "$d/workspace" -type f 2>/dev/null | wc -l)
    tex=$(find "$d/workspace" -name '*.tex' 2>/dev/null | wc -l)
    bib=$(find "$d/workspace" -name '*.bib' 2>/dev/null | wc -l)
    pdf=$(find "$d/workspace" -name '*.pdf' 2>/dev/null | wc -l)
    el="$(elapsed_of "$d")"
    printf '%-46s %-8s %-6s %-5s %-5s %-5s %-6s\n' "$t" "$state" "$files" "$tex" "$bib" "$pdf" "$el"
  done
}

# gate metrics for one task directory
gate_line() {
  local d="$1" t="$2"
  local ws paper
  ws="$d/workspace"; paper="$(paper_scope "$d")"
  local class prx floatbarrier refslabel bibitems bibentries uncited narration theorems sourceissues pdf
  IFS=$'\t' read -r class prx floatbarrier refslabel bibitems bibentries uncited narration theorems sourceissues < <(source_fields "$paper")
  [ "$bibitems" = "0" ] && bibitems="${bibentries}b"
  pdf="$(valid_pdf_of "$(candidate_pdf_of "$ws")")"
  printf '%-46s %-9s %-9s %-8s %-9s %-7s %-9s %-8s %-5s %-9s %s\n' \
    "$t" "$(state_of "$d")" "${class:0:30}" "$floatbarrier" "$refslabel" "$bibitems" "$uncited" "$narration" "$theorems" "$pdf" "$sourceissues"
}

cmd_gates() {
  local run; run="$(resolve_run "${1:-}")"; [ -z "$run" ] && die "no run found"
  echo "RUN=$(run_name "$run")"
  printf '%-46s %-9s %-9s %-9s %-8s %-9s %-7s %-9s %-8s %-9s %s\n' \
    TASK STATE CLASS FLOATBAR REFLABEL BIBITEMS UNCITED NARRATION THEOREMS VALIDPDF SOURCEISSUES
  local t
  for t in $(tasks_of "$run"); do gate_line "$run$t" "$t"; done
}

cmd_report() {
  local run; run="$(resolve_run "${1:-}")"; [ -z "$run" ] && die "no run found"
  local t total=0 finished=0 valid_pdf=0 valid_pdf_unknown=0 prx=0 ams=0 fb=0 bibliography_blocks=0 narr=0 zerothm=0 source_parse_issues=0
  local bibsum=0 bibn=0
  for t in $(tasks_of "$run"); do
    total=$((total+1))
    local d="$run$t" paper ws
    paper="$(paper_scope "$d")"
    ws="$d/workspace"
    [ -f "$d/exit-code" ] && finished=$((finished+1))
    local class is_prx is_float refslabel bibitems bibentries uncited n th issues pdf
    IFS=$'\t' read -r class is_prx is_float refslabel bibitems bibentries uncited n th issues < <(source_fields "$paper")
    [ "$is_prx" = "1" ] && prx=$((prx+1))
    [ "$class" = "amsart" ] && ams=$((ams+1))
    [ "$is_float" = "yes" ] && fb=$((fb+1))
    case "$refslabel" in manual|amsart|aps-native) bibliography_blocks=$((bibliography_blocks+1)) ;; esac
    [ "${n:-0}" != "0" ] && narr=$((narr+1))
    [ "$th" = "0" ] && zerothm=$((zerothm+1))
    source_parse_issues=$((source_parse_issues + issues))
    [ "$bibitems" -gt 0 ] && { bibsum=$((bibsum+bibitems)); bibn=$((bibn+1)); }
    pdf="$(valid_pdf_of "$(candidate_pdf_of "$ws")")"
    [ "$pdf" = "yes" ] && valid_pdf=$((valid_pdf+1))
    [ "$pdf" = "unknown" ] && valid_pdf_unknown=$((valid_pdf_unknown+1))
  done
  echo "RUN=$(run_name "$run")"
  echo "tasks=$total finished=$finished"
  echo "valid_pdf=$valid_pdf  valid_pdf_unknown=$valid_pdf_unknown  prx_class=$prx  amsart_class=$ams"
  echo "floatbarrier_present=$fb  bibliography_blocks_detected=$bibliography_blocks"
  echo "source_parse_issues=$source_parse_issues"
  echo "papers_with_bibliography_narration=$narr  papers_with_zero_theorem_envs=$zerothm"
  if [ "$bibn" -gt 0 ]; then echo "bibliography_entries: n=$bibn total=$bibsum mean=$((bibsum / bibn))"; fi
}

cmd_tail() {
  local run t n
  run="$(resolve_run "${1:-}")"; t="${2:-}"; n="${3:-40}"
  [ -z "$run" ] && die "no run found"; [ -z "$t" ] && die "usage: gewu-batch tail RUN TASK [N]"
  tail -n "$n" "$run$t/run.log"
}

cmd_show() {
  local run t f
  run="$(resolve_run "${1:-}")"; t="${2:-}"; f="${3:-}"
  [ -z "$run" ] && die "no run found"; [ -z "$t" ] && die "usage: gewu-batch show RUN TASK FILE"
  cat "$run$t/workspace/$f"
}

cmd_handover() {
  local out="" runs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out="$2"; shift 2 ;;
      *) runs+=("$1"); shift ;;
    esac
  done
  [ -z "$out" ] && die "usage: gewu-batch handover --out DIR [RUN...]"
  [ ${#runs[@]} -eq 0 ] && runs=("")
  rm -rf "$out"; mkdir -p "$out/.tmp"

  local r run t d ws pdf slug st
  # Later runs win: copy each candidate to .tmp/<slug>.{pdf,meta} so a re-run
  # of the same Solution replaces its earlier version instead of duplicating it.
  for r in "${runs[@]}"; do
    run="$(resolve_run "$r")"; [ -z "$run" ] && continue
    for t in $(tasks_of "$run"); do
      d="$run$t"; ws="$d/workspace"
      [ -f "$d/SUPERSEDED.md" ] && continue
      pdf=""
      for cand in "$ws/paper/main.pdf" "$ws/main.pdf"; do [ -f "$cand" ] && pdf="$cand" && break; done
      [ -z "$pdf" ] && pdf="$(find "$ws" -name '*.pdf' -not -path '*/research/*' 2>/dev/null | head -1)"
      [ -z "$pdf" ] && continue
      slug="$(printf '%s' "$t" | sed 's/^[0-9]*-//')"
      cp -f "$pdf" "$out/.tmp/$slug.pdf" || continue

      local pscope class is_prx is_float refslabel bibitems bibentries uncited narration thms sourceissues pages refs notes bbl
      pscope="$(paper_scope "$d")"
      IFS=$'\t' read -r class is_prx is_float refslabel bibitems bibentries uncited narration thms sourceissues < <(source_fields "$pscope")
      case "$class" in
        revtex4-2) [ "$is_prx" = "1" ] && class=revtex4-2/PRX || class=revtex4-2/non-PRX ;;
        amsart) class=amsart ;;
        article) class=article/neutral ;;
      esac
      pages=$(python3 -c "
import sys
try:
    import pypdfium2 as p
    print(len(p.PdfDocument(sys.argv[1])))
except Exception:
    print('-')
" "$out/.tmp/$slug.pdf" 2>/dev/null)
      bbl=$(find "$ws" -name '*.bbl' 2>/dev/null | head -1)
      if [ -n "$bbl" ]; then refs=$(grep -c '\\bibitem' "$bbl"); else refs="$(grep -c '^@' "$pscope/references.bib" 2>/dev/null || echo -)"; fi
      notes=$(find "$ws/research" -name '*.md' 2>/dev/null | wc -l)
      st="$(state_of "$d")"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$t" "$st" "$class" "$pages" "$refs" "$thms" "$notes" "$(run_name "$run")" > "$out/.tmp/$slug.meta"
    done
  done

  local index="$out/INDEX.md" csv="$out/INDEX.csv"
  {
    echo "# Manuscript handover"
    echo
    echo "Generated $(date -u +%Y-%m-%dT%H:%M:%SZ) from:"
    for r in "${runs[@]}"; do echo "- $(run_name "$(resolve_run "$r")")"; done
    echo
    echo "Label: candidate source drafts and PDF files. PDF presence does not establish compilation, freshness, scientific, visual, or acceptance validation."
    echo "Where a Solution appears in more than one run, the newest run wins."
    echo
    echo "| # | manuscript | state | class | pages | refs | thm | research notes | pdf | source run |"
    echo "|---|---|---|---|---|---|---|---|---|---|"
  } > "$index"
  echo "solution,state,class,pages,refs,theorems,research_notes,pdf,source_run" > "$csv"

  local idx=0 slug_pdf
  for slug_pdf in $(ls "$out/.tmp"/*.pdf 2>/dev/null | sort); do
    slug="$(basename "$slug_pdf" .pdf)"
    local meta="$out/.tmp/$slug.meta"
    [ -f "$meta" ] || continue
    idx=$((idx+1))
    cp -f "$slug_pdf" "$out/$slug.pdf"
    awk -F'\t' -v i="$idx" -v f="$slug.pdf" '{printf "| %d | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n", i, $1, $2, $3, $4, $5, $6, $7, f, $8}' "$meta" >> "$index"
    awk -F'\t' -v f="$slug.pdf" '{printf "%s,%s,%s,%s,%s,%s,%s,%s,%s\n", $1, $2, $3, $4, $5, $6, $7, f, $8}' "$meta" >> "$csv"
  done
  rm -rf "$out/.tmp"

  echo >> "$index"
  echo "Per-paper research trails (inventory, assessment, plan, provenance, literature," >> "$index"
  echo "validation) stay in the run directories; ask for a specific paper to see them." >> "$index"
  echo "handover: $idx manuscripts -> $out"
}

case "${1:-}" in
  list)    shift; cmd_list "$@" ;;
  watches) shift; cmd_watches "$@" ;;
  status)  shift; cmd_status "$@" ;;
  gates)   shift; cmd_gates "$@" ;;
  report)  shift; cmd_report "$@" ;;
  tail)    shift; cmd_tail "$@" ;;
  show)    shift; cmd_show "$@" ;;
  handover) shift; cmd_handover "$@" ;;
  ""|-h|--help|help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (try: gewu-batch help)" ;;
esac
