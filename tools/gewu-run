#!/usr/bin/env bash
# gewu-run — run ONE paper-writing task headlessly, with a stall watchdog and
# automatic retries.
#
# Per-task contract (same as the batch launchers):
#   DIR/pid, DIR/started-at, DIR/run.log, DIR/exit-code, DIR/finished-at
# plus DIR/stall-detected when the watchdog fires.
#
# Why the watchdog: a stalled request to the model provider keeps pi alive with
# almost no CPU and no file writes. Observed five times in the first batches
# (75 minutes wasted in one case). The watchdog kills a task whose workspace
# stops changing, and --retries re-runs it; the workspace is kept, so the task
# resumes from the files it already wrote instead of starting over.
#
# Usage:
#   gewu-run --task-dir DIR [--model ID] [--provider P] [--timeout 7200]
#            [--stall 1200] [--no-progress 3600] [--retries 1]
#            [--skill PATH] [--thinking high]
set -uo pipefail

TASK_DIR=""; MODEL="glm-5.3"; PROVIDER="gravarc-router"; TIMEOUT=7200   # GLM is the writing model; deepseek is retired
STALL=1200; RETRIES=1; THINKING=high; NO_PROGRESS=3600
SKILL="${GEWU_SKILL:-$HOME/GeWu_Auto_Writing/.agents/skills/paperwriter-pi/SKILL.md}"

while [ $# -gt 0 ]; do
  case "$1" in
    --task-dir) TASK_DIR="$2"; shift 2 ;;
    --model)    MODEL="$2"; shift 2 ;;
    --provider) PROVIDER="$2"; shift 2 ;;
    --timeout)  TIMEOUT="$2"; shift 2 ;;
    --stall)    STALL="$2"; shift 2 ;;
    --no-progress) NO_PROGRESS="$2"; shift 2 ;;
    --retries)  RETRIES="$2"; shift 2 ;;
    --skill)    SKILL="$2"; shift 2 ;;
    --thinking) THINKING="$2"; shift 2 ;;
    *) echo "gewu-run: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

[ -n "$TASK_DIR" ] || { echo "gewu-run: --task-dir is required" >&2; exit 2; }
[ -f "$TASK_DIR/task.md" ] || { echo "gewu-run: no task.md in $TASK_DIR" >&2; exit 2; }

export PATH="$HOME/.local/bin:$HOME/texlive/2026/bin/x86_64-linux:$PATH"
command -v pi >/dev/null 2>&1 || { echo "gewu-run: pi not on PATH" >&2; exit 1; }
mkdir -p "$TASK_DIR/workspace"


# CPU ticks of the pi process and its descendants (3 levels). A long legitimate
# computation changes no files but burns CPU; a provider stall burns none. Using
# both signals keeps the watchdog from killing honest work.
cpu_ticks() {
  local root="$1" total=0 p c g
  for p in "$root" $(pgrep -P "$root" 2>/dev/null); do
    if [ -r "/proc/$p/stat" ]; then
      total=$(( total + $(awk '{print $14+$15}' "/proc/$p/stat" 2>/dev/null || echo 0) ))
    fi
    for c in $(pgrep -P "$p" 2>/dev/null); do
      if [ -r "/proc/$c/stat" ]; then
        total=$(( total + $(awk '{print $14+$15}' "/proc/$c/stat" 2>/dev/null || echo 0) ))
      fi
      for g in $(pgrep -P "$c" 2>/dev/null); do
        [ -r "/proc/$g/stat" ] && total=$(( total + $(awk '{print $14+$15}' "/proc/$g/stat" 2>/dev/null || echo 0) ))
      done
    done
  done
  echo "$total"
}

NAME="$(basename "$TASK_DIR")"
MAX_ATTEMPTS=$(( RETRIES + 1 ))
attempt=0
RC=0
# Provider faults get their own budget. An intermittent router error is not a
# reason to abandon a manuscript: 31 attempts died to one such error in a single
# round while every task was still making progress. Bounded by a wall-clock
# deadline so a permanent outage still terminates.
MAX_FAULTS=${MAX_FAULTS:-12}
FAULTS=0
DEADLINE=$(( $(date +%s) + ${MAX_WALL:-21600} ))

date -u +%Y-%m-%dT%H:%M:%SZ > "$TASK_DIR/started-at"

while : ; do
  attempt=$(( attempt + 1 ))
  rm -f "$TASK_DIR/stall-detected" "$TASK_DIR/no-progress-detected" "$TASK_DIR/exit-code" "$TASK_DIR/finished-at"

  cd "$TASK_DIR" || exit 1
  timeout "$TIMEOUT" pi \
    --print \
    --no-session \
    --provider "$PROVIDER" \
    --model "$MODEL" \
    --thinking "$THINKING" \
    --no-context-files \
    --no-approve \
    --no-extensions \
    --no-skills \
    --no-prompt-templates \
    --no-themes \
    --tools read,write,edit,bash,grep,find,ls \
    --skill "$SKILL" \
    "@$TASK_DIR/task.md" > "$TASK_DIR/run.log" 2>&1 &
  PI_PID=$!
  echo "$PI_PID" > "$TASK_DIR/pid"

  # Watchdog: stop the attempt when the workspace stops changing.
  # The stall baseline is per attempt. A retry keeps the workspace from the
  # previous attempt, so measuring against the newest file alone would declare
  # the new attempt dead on its first check (that bug killed attempts 2-3 in
  # the first retry run within minutes).
  attempt_start=$(date +%s)
  progress_base=$attempt_start
  last_cpu=$(cpu_ticks "$PI_PID")
  export last_cpu attempt_start progress_base
  (
    while kill -0 "$PI_PID" 2>/dev/null; do
      sleep 60
      newest=$(find "$TASK_DIR/workspace" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)
      now=$(date +%s)
      # liveness: file written this attempt, or CPU consumed since last check
      cpu=$(cpu_ticks "$PI_PID")
      if [ "${cpu:-0}" -gt "$(( ${last_cpu:-0} + 50 ))" ]; then
        last_cpu=$cpu
        attempt_start=$now
      fi
      if [ -z "$newest" ] || [ "$newest" -lt "$attempt_start" ]; then
        baseline=$attempt_start
      else
        baseline=$newest
      fi
      idle=$(( now - baseline ))
      # A second, slower clock that CPU activity must not reset: the skill
      # requires check scripts to write their output inside the workspace, so an
      # hour without a single file change is a defect even on a busy core.
      if [ -n "$newest" ] && [ "$newest" -gt "${progress_base:-$attempt_start}" ]; then
        progress_base=$newest
      fi
      no_prog=$(( now - ${progress_base:-$attempt_start} ))
      if [ "$no_prog" -gt "$NO_PROGRESS" ]; then
        echo "no progress: no workspace file change for ${no_prog}s (limit ${NO_PROGRESS}s) although the process was alive" > "$TASK_DIR/no-progress-detected"
        pkill -TERM -P "$PI_PID" 2>/dev/null
        kill -TERM "$PI_PID" 2>/dev/null
        sleep 5
        pkill -KILL -P "$PI_PID" 2>/dev/null
        kill -KILL "$PI_PID" 2>/dev/null
        break
      fi
      if [ "$idle" -gt "$STALL" ]; then
        echo "stalled: no workspace change for ${idle}s (limit ${STALL}s)" > "$TASK_DIR/stall-detected"
        pkill -TERM -P "$PI_PID" 2>/dev/null
        kill -TERM "$PI_PID" 2>/dev/null
        sleep 5
        pkill -KILL -P "$PI_PID" 2>/dev/null
        kill -KILL "$PI_PID" 2>/dev/null
        break
      fi
    done
  ) &
  WATCH_PID=$!

  wait "$PI_PID"; RC=$?
  wait "$WATCH_PID" 2>/dev/null

  if [ -f "$TASK_DIR/stall-detected" ] || [ -f "$TASK_DIR/no-progress-detected" ] || [ "$RC" -ne 0 ]; then
    mv -f "$TASK_DIR/run.log" "$TASK_DIR/run.log.attempt${attempt}" 2>/dev/null
    if [ "$attempt" -lt "$MAX_ATTEMPTS" ]; then
      reason="exit $RC"
      [ -f "$TASK_DIR/stall-detected" ] && reason="provider stall"
      [ -f "$TASK_DIR/no-progress-detected" ] && reason="no progress for over ${NO_PROGRESS}s"
      # Escalating backoff. A flat 30s once burned all four attempts inside a
      # transient router outage that lasted under two minutes, and a whole
      # 30-task batch died with zero manuscripts for a provider fault.
      LOG="$TASK_DIR/run.log.attempt${attempt}"
      # A log of a few hundred bytes means the attempt died before doing any work
      # at all: an infrastructure fault, not a hard task. Such an attempt does
      # not consume the task's retry budget, it consumes the fault budget.
      if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -lt 400 ]; then
        FAULTS=$(( FAULTS + 1 ))
        attempt=$(( attempt - 1 ))
        case "$FAULTS" in
          1|2) BACKOFF=120 ;;
          3|4) BACKOFF=300 ;;
          *)   BACKOFF=600 ;;
        esac
        reason="$reason; no work done, provider fault $FAULTS/$MAX_FAULTS"
        if [ "$FAULTS" -lt "$MAX_FAULTS" ] && [ "$(date +%s)" -lt "$DEADLINE" ]; then
          echo "gewu-run: $NAME attempt $attempt failed ($reason); retrying in ${BACKOFF}s" >&2
          sleep "$BACKOFF"
          continue
        fi
        echo "gewu-run: $NAME giving up after $FAULTS provider faults ($reason)" >&2
      else
        case "$attempt" in
          1) BACKOFF=60 ;;
          2) BACKOFF=180 ;;
          *) BACKOFF=420 ;;
        esac
        echo "gewu-run: $NAME attempt $attempt failed ($reason); retrying in ${BACKOFF}s" >&2
        sleep "$BACKOFF"
        continue
      fi
    fi
  fi
  break
done

echo "$RC" > "$TASK_DIR/exit-code"
date -u +%Y-%m-%dT%H:%M:%SZ > "$TASK_DIR/finished-at"
if [ -f "$TASK_DIR/stall-detected" ] || [ -f "$TASK_DIR/no-progress-detected" ]; then
  echo "gewu-run: $NAME STOPPED BY WATCHDOG after $attempt attempt(s) (exit $RC)" >&2
else
  echo "gewu-run: $NAME exit $RC after $attempt attempt(s)" >&2
fi
exit $RC
